{% extends 'base.html.twig' %}

{% block title %}Location index{% endblock %}

{% block body %}
    <h1 class="mb-3">Location index</h1>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="text-nowrap">
                <tr>
                    <th class="d-none d-md-table-cell">Id</th>
                    <th>Name</th>
                    <th>Country</th>
                    <th class="d-none d-md-table-cell">Latitude</th>
                    <th class="d-none d-md-table-cell">Longitude</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for location in locations %}
                <tr>
                    <td class="d-none d-md-table-cell">{{ location.id }}</td>
                    <td>{{ location.name }}</td>
                    <td>{{ location.country }}</td>
                    <td class="d-none d-md-table-cell">{{ location.latitude }}</td>
                    <td class="d-none d-md-table-cell">{{ location.longitude }}</td>
                    <td class="text-nowrap">
                        <div class="d-inline-flex gap-1">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_location_show', {'id': location.id}) }}">show</a>
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('app_location_edit', {'id': location.id}) }}">edit</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-2 mb-4">
        <a class="btn btn-primary" href="{{ path('app_location_new') }}">Create new</a>
    </div>
{% endblock %}
